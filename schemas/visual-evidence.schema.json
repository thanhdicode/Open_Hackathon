{
  "title": "visualEvidence",
  "type": "object",
  "properties": {
    "scene": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "visibleTexts": {
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "language": {
            "type": "string",
            "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
          },
          "box": {
            "type": "object",
            "properties": {
              "ymin": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000
              },
              "xmin": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000
              },
              "ymax": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000
              },
              "xmax": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000
              }
            },
            "required": [
              "ymin",
              "xmin",
              "ymax",
              "xmax"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "text",
          "box"
        ],
        "additionalProperties": false
      }
    },
    "objects": {
      "maxItems": 5,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "box": {
            "type": "object",
            "properties": {
              "ymin": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000
              },
              "xmin": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000
              },
              "ymax": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000
              },
              "xmax": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000
              }
            },
            "required": [
              "ymin",
              "xmin",
              "ymax",
              "xmax"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "label"
        ],
        "additionalProperties": false
      }
    },
    "visibleLanguages": {
      "maxItems": 3,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
      }
    }
  },
  "required": [
    "scene",
    "visibleTexts",
    "objects",
    "visibleLanguages"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}

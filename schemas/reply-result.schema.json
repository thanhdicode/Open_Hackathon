{
  "title": "YapReplyResult",
  "type": "object",
  "properties": {
    "intentSummary": {
      "type": "string",
      "minLength": 1
    },
    "targetLanguage": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
    },
    "variants": {
      "minItems": 1,
      "maxItems": 4,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "casual",
              "neutral",
              "academic",
              "very_respectful"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "romanization": {
            "type": "string"
          },
          "backTranslation": {
            "type": "string",
            "minLength": 1
          },
          "why": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "mode",
          "text",
          "backTranslation",
          "why"
        ],
        "additionalProperties": false
      }
    },
    "warnings": {
      "maxItems": 4,
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "confidence": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "label",
        "reason"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "intentSummary",
    "targetLanguage",
    "variants",
    "warnings",
    "confidence"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}

{
  "title": "YapLectureResult",
  "type": "object",
  "properties": {
    "transcript": {
      "type": "string"
    },
    "detectedLanguages": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
      }
    },
    "translation": {
      "type": "string"
    },
    "concepts": {
      "maxItems": 12,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "term": {
            "type": "string",
            "minLength": 1
          },
          "explanation": {
            "type": "string",
            "minLength": 1
          },
          "importance": {
            "type": "string",
            "enum": [
              "core",
              "supporting",
              "tangential"
            ]
          }
        },
        "required": [
          "term",
          "explanation",
          "importance"
        ],
        "additionalProperties": false
      }
    },
    "unclearMoments": {
      "maxItems": 6,
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "actionItems": {
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string"
          },
          "dueHint": {
            "type": "string"
          }
        },
        "required": [
          "text"
        ],
        "additionalProperties": false
      }
    },
    "confidence": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "label",
        "reason"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "transcript",
    "detectedLanguages",
    "concepts",
    "unclearMoments",
    "actionItems",
    "confidence"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}

{
  "title": "YapSimScenario",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "context": {
      "type": "string",
      "minLength": 1
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "domain": {
      "type": "string",
      "enum": [
        "food",
        "transport",
        "campus",
        "classroom",
        "group_work",
        "professor",
        "social",
        "housing",
        "banking",
        "sim",
        "health",
        "safety",
        "police",
        "immigration",
        "shopping",
        "religion",
        "events",
        "clubs",
        "part_time",
        "travel"
      ]
    },
    "difficulty": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "targetLanguage": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
    },
    "coachingLanguage": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
    },
    "persona": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "traits": {
          "minItems": 1,
          "maxItems": 4,
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "register": {
          "type": "string",
          "enum": [
            "informal",
            "neutral",
            "formal",
            "authority"
          ]
        }
      },
      "required": [
        "name",
        "role",
        "traits",
        "register"
      ],
      "additionalProperties": false
    },
    "openingLine": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "translation": {
          "type": "string",
          "minLength": 1
        },
        "romanization": {
          "type": "string"
        }
      },
      "required": [
        "text",
        "translation"
      ],
      "additionalProperties": false
    },
    "successCriteria": {
      "minItems": 1,
      "maxItems": 5,
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "maxTurns": {
      "type": "integer",
      "minimum": 3,
      "maximum": 5
    }
  },
  "required": [
    "title",
    "context",
    "goal",
    "domain",
    "difficulty",
    "targetLanguage",
    "coachingLanguage",
    "persona",
    "openingLine",
    "successCriteria",
    "maxTurns"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}

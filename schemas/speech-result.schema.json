{
  "title": "YapSpeechResult",
  "type": "object",
  "properties": {
    "text": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
    },
    "audioBase64": {
      "type": "string",
      "minLength": 1
    },
    "mimeType": {
      "type": "string",
      "pattern": "^audio\\/"
    },
    "voiceName": {
      "type": "string"
    },
    "durationMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "text",
    "language",
    "audioBase64",
    "mimeType"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}

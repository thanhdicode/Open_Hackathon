{
  "title": "YapAssignmentResult",
  "type": "object",
  "properties": {
    "deliverables": {
      "minItems": 1,
      "maxItems": 10,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string"
          },
          "dueHint": {
            "type": "string"
          }
        },
        "required": [
          "text"
        ],
        "additionalProperties": false
      }
    },
    "deadlineHints": {
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "explicit": {
            "type": "boolean"
          }
        },
        "required": [
          "text",
          "source",
          "explicit"
        ],
        "additionalProperties": false
      }
    },
    "rubric": {
      "maxItems": 10,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "criterion": {
            "type": "string",
            "minLength": 1
          },
          "detail": {
            "type": "string"
          },
          "weight": {
            "type": "string"
          }
        },
        "required": [
          "criterion"
        ],
        "additionalProperties": false
      }
    },
    "ambiguities": {
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "questionsToAsk": {
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "confidence": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "label",
        "reason"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "deliverables",
    "deadlineHints",
    "rubric",
    "ambiguities",
    "questionsToAsk",
    "confidence"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}

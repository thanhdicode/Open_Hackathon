{
  "title": "YapGreenbookAnswer",
  "type": "object",
  "properties": {
    "answer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2400
    },
    "whatToDo": {
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 400
      }
    },
    "whatToPrepare": {
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 400
      }
    },
    "whatToSay": {
      "maxItems": 6,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 400
      }
    },
    "warnings": {
      "maxItems": 5,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 400
      }
    },
    "confidence": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "citedSourceIds": {
      "maxItems": 12,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 64
      }
    }
  },
  "required": [
    "answer",
    "whatToDo",
    "whatToPrepare",
    "whatToSay",
    "warnings",
    "confidence",
    "citedSourceIds"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}

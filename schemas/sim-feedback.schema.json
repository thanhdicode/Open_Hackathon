{
  "title": "YapSimFeedback",
  "type": "object",
  "properties": {
    "scores": {
      "type": "object",
      "properties": {
        "languageClarity": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "tone": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "intentRecognition": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "contextAwareness": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "adaptability": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "confidence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        }
      },
      "required": [
        "languageClarity",
        "tone",
        "intentRecognition",
        "contextAwareness",
        "adaptability",
        "confidence"
      ],
      "additionalProperties": false
    },
    "priorityFeedback": {
      "type": "string",
      "minLength": 1
    },
    "strengths": {
      "maxItems": 3,
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "examples": {
      "maxItems": 3,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "userText": {
            "type": "string",
            "minLength": 1
          },
          "feedback": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "userText",
          "feedback"
        ],
        "additionalProperties": false
      }
    },
    "retryGoal": {
      "type": "string",
      "minLength": 1
    },
    "recommendedPractice": {
      "type": "string"
    }
  },
  "required": [
    "scores",
    "priorityFeedback",
    "strengths",
    "retryGoal"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}

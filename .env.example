# Public browser-safe
VITE_APPWRITE_ENDPOINT=https://<REGION>.cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=
VITE_APPWRITE_DATABASE_ID=
VITE_APPWRITE_TEMP_MEDIA_BUCKET_ID=
VITE_APPWRITE_PROFILE_MEDIA_BUCKET_ID=profile_media
VITE_APPWRITE_COMMUNITY_MEDIA_BUCKET_ID=community_media

# Server/Appwrite Function only — NEVER expose via VITE_*
APPWRITE_API_KEY=

# AI providers — server-only, routed by ai-gateway per docs/adr/ADR-002-multi-provider-ai-routing.md
# Primary multimodal/reasoning (gemini-3.8-flash, fallback gemini-3.7-flash; see ADR-001)
GEMINI_API_KEY=
# Fast text-only Lens/tone/reply + structured JSON (gpt-oss-120b) + cheap fallback (qwen3-27b) + STT (whisper-large-v3-turbo)
GROQ_API_KEY=
# Emergency free fallback (Workers AI)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# Last-resort router across free-tier models
OPENROUTER_API_KEY=

# Optional
APPWRITE_BUCKET_TEMP_MEDIA=
APP_BASE_URL=
